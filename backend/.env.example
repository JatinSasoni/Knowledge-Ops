# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Postgres (docker container on 5433 locally)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/knowledge_ops?schema=public

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access token lifetime (jsonwebtoken format) and refresh token lifetime in days
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
