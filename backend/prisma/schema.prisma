

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum DocStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum Role {
  ADMIN 
  MEMBER
}

enum MessageRole {
  USER
  ASSISTANT
}

enum WorkspaceVisibility {
  PRIVATE  
  PUBLIC  
}


model User{
  id  String @id @default(uuid())
  email String @unique
  name String?
  password String
  members Member[]
  conversations Conversation[]
  createdAt DateTime @default(now())
  refreshTokens RefreshToken[]
}

model RefreshToken{
  id String @id @default(uuid())
  tokenHash String @unique
  familyId String
  userId String
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  @@index([userId])
  @@index([familyId])
}

model Workspace{
  id String @id @default(uuid())
  name String
  slug String @unique
  visibility WorkspaceVisibility @default(PRIVATE)
  members Member[]
  documents Document[]
  chunk DocumentChunk[]
  conversations Conversation[]
  createdAt DateTime @default(now())
}

model Member {
  id String @id @default(uuid())
  role Role @default(MEMBER)
  userId String
  workspaceId String
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId],references: [id],onDelete: Cascade)
  createdAt   DateTime  @default(now())
  @@unique([userId,workspaceId])
  @@index([workspaceId])
}

model Document {
  id String @id @default(uuid())
  title String
  fileKey     String?
  mimeType    String?
  size Int?
  status DocStatus @default(UPLOADED)
  error String?
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId],references: [id],onDelete: Cascade)
  createdAt DateTime @default(now())
  chunk DocumentChunk[]

  @@index([workspaceId])
}

model DocumentChunk {
  id String @id @default(uuid())
  embedding   Unsupported("vector(1536)")?
  documentId String
  workspaceId String
  index Int // position in the document: 0, 1, 2… (used for citations later)
  content String
  tokenCount Int
  document Document @relation(fields: [documentId],references: [id],onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([documentId, index])
  @@index([workspaceId])
}

model Conversation {
  id          String    @id @default(uuid())
  title       String
  workspaceId String
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  citations      Json?        // the sources shown with an answer: [{ n, documentId, documentTitle, index, content, similarity }]
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}